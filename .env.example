# 复制为仓库根目录或 backend 旁的环境变量文件后按需修改

# MySQL（默认与本地开发一致）
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/yanjiusheng?charset=utf8mb4

# JWT（生产必须修改；设 JWT_SECRET_REQUIRED=1 可强制要求自定义密钥）
JWT_SECRET=please-change-me-to-a-long-random-string
# JWT_SECRET_REQUIRED=1

# 是否自动创建演示账号 admin/director/teacher（默认 1；生产建议 0）
ALLOW_DEFAULT_ADMIN=1

# Swagger 无验证码登录 /auth/login（默认 1；生产建议 0）
ALLOW_OAUTH_PASSWORD_LOGIN=1
